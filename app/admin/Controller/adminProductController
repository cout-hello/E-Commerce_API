const {
  getProductsService,
  addProductService,
  deleteAllProdectService,
  getProductByIdService,
} = require("../../api/Service/productService");

//all users can send req.
// Req for one product by id
const getAdminProductByIdController = async (req, res, next) => {
  try {
    const product = await getProductByIdService(req.params.id);
    return res.status(200).render("Admin/product_details", { product });
  } catch (error) {
    return res.status(500).json({ message: error.message });
  }
};

//all users can send req.
const getAdminProductsController = async (req, res, next) => {
  try {
    const productList = await getProductsService();
    return res.status(200).render("Admin/products_list", { productList });
  } catch (error) {
    return res.status(500).render({ message: error.message });
  }
};

/* deleteAllProdectService() methode return object 
{
  acknowledged: true,
  deletedCount: 0 --> i send this directly
}
*/
const deleteAdminallProductController = async (req, res, next) => {
  try {
    const deleteResult = await deleteAllProdectService();
    const deletedCount = deleteResult.deletedCount;
    return res
      .status(200)
      .render({ message: "deleted " + deletedCount + " Done" });
  } catch (error) {
    return res.status(500).render({ message: error.message });
  }
};

//check from req.body
const addAdminProductController = async (req, res, next) => {
  try {
    const product = await addProductService(req.body);
    return res
      .status(200)
      .render({ message: "product added", product: product._id });
  } catch (error) {
    return res.status(500).render({ message: error.message });
  }
};

module.exports = {
  getAdminProductsController,
  addAdminProductController,
  deleteAdminallProductController,
  getAdminProductByIdController,
};
