<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Products List — Admin Panel</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body data-page="products">

  <div class="app-layout">

    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <span class="brand-mark">A</span>
        <span class="brand-name">Admin Panel</span>
      </div>

      <nav class="sidebar-nav">
        <a href="/products" class="nav-link active">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
          </svg>
          <span>Products</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <div class="sidebar-user">
          <div class="user-avatar">A</div>
          <div class="user-info">
            <span class="user-name">Admin User</span>
            <span class="user-role">Store Manager</span>
          </div>
        </div>
      </div>
    </aside>

    <div class="main-wrapper">

      <header class="topbar">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <span class="topbar-title">E-commerce Admin</span>
      </header>

      <main class="page-content">

        <div class="page-header">
          <div>
            <h1 class="page-title">Products</h1>
            <p class="page-subtitle">View and manage your store's product catalog</p>
          </div>
        </div>

        <div class="toolbar">
          <div class="search-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="productSearch" placeholder="Search products..." />
          </div>
        </div>

        <div class="table-card">
          <div class="table-responsive">
            <table class="data-table" id="productsTable">
              <thead>
                <tr>
                  <th>Product ID</th>
                  <th>Name</th>
                  <th>Price</th>
                  <th>Stock</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>

                
                <%productList.forEach(displayProductFun);%>
                
                  <%function displayProductFun(product, index){%>
                    <tr>
                      <td data-lable="Product ID"><%=index+1%></td>
                      <td data-lable="Name"><%=product.name%></td>
                      <td data-lable="Price"><%=product.price%></td>
                      <td data-lable="Stock"><%=product.stock%></td>
                      <td data-lable="Actions">
                          <a href="/admin/product_details/<%=product._id%>" class="btn btn-outline btn-sm">View</a>
                      </td>
                    </tr>
                  <%};%>

              </tbody>
            </table>
          </div>
        </div>

      </main>
    </div>
  </div>

  <!-- Mobile sidebar overlay -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <script src="js/app.js"></script>
</body>
</html>
