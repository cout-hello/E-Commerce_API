<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Product Details — Admin Panel</title>
  <link rel="stylesheet" href="../css/style.css" />
</head>
<body data-page="product-details">

  <div class="app-layout">

    <!-- ==================================================================
         Sidebar (identical to products.html)
         Future EJS partial: partials/sidebar.ejs
         ================================================================== -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <span class="brand-mark">A</span>
        <span class="brand-name">Admin Panel</span>
      </div>

      <nav class="sidebar-nav">
        <a href="products.html" class="nav-link active">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
          </svg>
          <span>Products</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <div class="sidebar-user">
          <div class="user-avatar">A</div>
          <div class="user-info">
            <span class="user-name">Admin User</span>
            <span class="user-role">Store Manager</span>
          </div>
        </div>
      </div>
    </aside>

    <div class="main-wrapper">

      <!-- ================================================================
           Topbar (identical to products.html)
           Future EJS partial: partials/topbar.ejs
           ================================================================ -->
      <header class="topbar">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <span class="topbar-title">E-commerce Admin</span>
      </header>

      <main class="page-content">

        <div class="page-header">
          <div>
            <a href="products.html" class="back-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              Back to Products
            </a>
            <h1 class="page-title">Product Details</h1>
          </div>

          <!-- Optional actions — kept visually secondary -->
          <div class="page-header-actions">
            <button type="button" class="btn btn-secondary btn-sm">Edit</button>
            <button type="button" class="btn btn-danger-outline btn-sm">Delete</button>
          </div>
        </div>

        <!--
          Future EJS note:
          Every value below is populated by app.js at runtime by looking up
          the ?id= query param against a PRODUCTS array (standing in for a
          database). Once converted to EJS, this whole lookup happens on
          the server instead, and each element below just becomes:
            <span class="detail-value"><%= product.name %></span>
          The id="..." attributes and app.js population logic can then be
          removed.
        -->
        <div class="details-layout">

          <div class="details-card">
            <div class="detail-row">
              <span class="detail-label">Product ID</span>
              <span class="detail-value" id="productId">P001</span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Product Name</span>
              <span class="detail-value" id="productName">Wireless Bluetooth Headphones</span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Price</span>
              <span class="detail-value" id="productPrice">$79.99</span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Category</span>
              <span class="detail-value" id="productCategory">Electronics</span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Stock</span>
              <span class="detail-value">
                <span id="productStockNum">34</span>
                <span class="badge badge-success" id="productStockBadge">In Stock</span>
              </span>
            </div>

            <div class="detail-row detail-row-block">
              <span class="detail-label">Description</span>
              <p class="detail-value" id="productDescription">
                Over-ear wireless headphones with active noise cancellation, 30-hour battery life, and a foldable design for easy travel.
              </p>
            </div>

            <div class="detail-row">
              <span class="detail-label">Created At</span>
              <span class="detail-value" id="productCreatedAt">2024-11-02</span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Updated At</span>
              <span class="detail-value" id="productUpdatedAt">2025-01-15</span>
            </div>
          </div>

          <!-- Secondary image area -->
          <div class="details-image-card">
            <div class="image-placeholder">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
              <span>No image available</span>
            </div>
          </div>

        </div>

      </main>
    </div>
  </div>

  <!-- Mobile sidebar overlay -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <script src="js/app.js"></script>
</body>
</html>